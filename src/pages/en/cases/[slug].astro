---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CaseDetail from '@/components/CaseDetail.astro';
import { getProjects, projectSlug, type Project } from '@/lib/projects';

export const getStaticPaths = (async () => {
  const projects = await getProjects('en');
  return projects.map((project) => ({ params: { slug: projectSlug(project) }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props as { project: Project };
---

<BaseLayout title={project.data.title} description={project.data.summary} type="article">
  <CaseDetail lang="en" project={project} />
</BaseLayout>
