---
import { Picture } from 'astro:assets';
import Button from './Button.astro';
import avatar from '@/assets/avatar.jpg';
import { site } from '@/config/site';
import type { Lang } from '@/i18n/ui';
import { localePath, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const base = localePath(lang) === '/' ? '' : localePath(lang);

// Foto opcional: recorte sem fundo em src/assets/profile.(png|webp|jpg).
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/profile.{png,webp,jpg,jpeg}', { eager: true });
const photo = Object.values(photos)[0]?.default;
const linkedinHandle = site.social.linkedin.replace(/^https?:\/\/(www\.)?linkedin\.com\/(in\/)?/, '').replace(/\/$/, '');
---

<section aria-labelledby="hero-title" class="relative isolate overflow-hidden">
  <div class="container-page relative flex min-h-[calc(100svh-4rem)] flex-col pt-6 pb-4 sm:pt-8">
    <!-- Linha superior: três palavras distribuídas -->
    <div class="grid grid-cols-2 text-sm sm:grid-cols-3 sm:text-base" data-reveal>
      <span>{t('hero.topLeft')}</span>
      <span class="hidden text-center sm:block">{t('hero.topCenter')}</span>
      <span class="text-right">{site.name}</span>
    </div>

    <!-- Palco: frase dividida em volta da foto, que "estoura" o topo de um quadro de linha fina -->
    <div class="relative mt-10 grid flex-1 items-center gap-8 lg:mt-0 lg:grid-cols-[minmax(0,1fr)_25rem_minmax(0,1fr)] lg:gap-10">
      <div
        class="hero-frame pointer-events-none absolute bottom-0 left-1/2 -z-10 hidden h-[66%] w-[25rem] -translate-x-1/2 rounded-t-[2rem] border border-b-0 border-fg/25 lg:block"
        aria-hidden="true"
      >
      </div>

      <div class="flex flex-col gap-5 lg:self-center" data-reveal>
        <a
          href={site.social.linkedin}
          rel="me noopener"
          target="_blank"
          class="inline-flex min-h-8 w-fit items-center gap-2 rounded-full border border-fg/30 py-1 pr-3 pl-1 text-xs transition-colors duration-300 hover:border-fg"
        >
          <Picture src={avatar} alt="" widths={[48]} sizes="24px" formats={['avif', 'webp']} class="size-6 rounded-full object-cover" />
          @{linkedinHandle}
        </a>
        <p class="max-w-xs text-3xl leading-[1.1] font-light tracking-tight text-fg-muted sm:text-4xl" aria-hidden="true">
          {t('hero.leftLight')} <strong class="font-semibold text-fg">{t('hero.leftBold')}</strong>
        </p>
        <!-- Provas verificáveis (currículo e certificados com link) -->
        <ul class="mt-2 space-y-2.5 border-l border-fg/20 pl-4 text-sm text-fg-muted">
          <li class="flex items-center gap-2">
            <svg class="size-4 shrink-0 text-fg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3l2.6 1.9 3.2-.1 1 3.1 2.6 1.9-1 3.1 1 3.1-2.6 1.9-1 3.1-3.2-.1L12 21l-2.6-1.9-3.2.1-1-3.1L2.6 14.2l1-3.1-1-3.1 2.6-1.9 1-3.1 3.2.1z"></path>
              <path d="M8.5 12l2.5 2.5 4.5-5"></path>
            </svg>
            <span><strong class="font-semibold text-fg tabular-nums">{site.stats.anthropicCerts}</strong> {t('hero.certs')}</span>
          </li>
          <li class="flex items-center gap-2">
            <svg class="size-4 shrink-0 text-fg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="7" y="2.5" width="10" height="19" rx="2.5"></rect>
              <path d="M11 18.5h2"></path>
            </svg>
            <span>{t('hero.proofApp')}</span>
          </li>
        </ul>
      </div>

      <!-- Foto central -->
      <div class="relative mx-auto flex h-[22rem] w-full justify-center sm:h-[30rem] lg:order-none lg:h-full lg:self-stretch" data-parallax="0.06">
        {
          photo ? (
            <Picture
              src={photo}
              alt={t('hero.photoAlt')}
              formats={['avif', 'webp']}
              widths={[400, 640, 1000]}
              sizes="(min-width: 1024px) 460px, 80vw"
              loading="eager"
              fetchpriority="high"
              class="hero-photo absolute bottom-0 left-1/2 h-full w-auto max-w-none -translate-x-1/2 object-contain object-bottom lg:h-[88%]"
            />
          ) : (
            <div class="flex size-full items-end justify-center text-6xl font-semibold text-fg/20">{site.initials}</div>
          )
        }
      </div>

      <!-- A frase completa fica num único h1; visualmente ela se divide em volta da foto. -->
      <div class="order-first flex flex-col gap-7 lg:order-none lg:self-center" data-reveal>
        <h1 id="hero-title">
          <span class="sr-only">{t('hero.leftLight')} {t('hero.leftBold')} </span>
          <span class="block text-[clamp(2.75rem,1.3rem+3.1vw,4.4rem)] leading-[0.95] font-light tracking-[-0.05em]">
            {t('hero.rightLight')} <strong class="block font-semibold">{t('hero.rightBold')}</strong>
          </span>
        </h1>
        <div class="flex flex-wrap gap-3">
          <Button href={`${base}/#projetos`} arrow magnetic>{t('hero.ctaProjects')}</Button>
          <Button href={`${base}/#contato`} variant="ghost" magnetic>{t('hero.ctaContact')}</Button>
          {
            site.resumePdf && (
              <Button href={site.resumePdf} variant="ghost" download>
                {t('hero.ctaResume')}
              </Button>
            )
          }
        </div>
      </div>
    </div>

    <!-- Linha inferior: espelha a superior -->
    <div class="mt-10 grid grid-cols-2 gap-y-2 border-t border-fg/15 pt-4 text-sm sm:grid-cols-3 lg:mt-0" data-reveal>
      <span>{site.stats.yearsWithSensitiveData}+ {t('hero.barExp')}</span>
      <a href="#sobre" class="hidden items-center justify-center gap-2 hover:underline sm:inline-flex">
        {t('hero.scroll')}
        <svg class="size-3.5 animate-scroll-hint" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M12 5v14M6 13l6 6 6-6"></path>
        </svg>
      </a>
      <span class="text-right">{t('hero.available')}</span>
    </div>
  </div>
</section>

<style>
  /* Recorte sem fundo: funde a base e as laterais (o enquadramento original corta os ombros). */
  .hero-photo {
    mask-image: linear-gradient(to bottom, #000 70%, transparent), linear-gradient(to right, transparent, #000 20%, #000 80%, transparent);
    mask-composite: intersect;
  }
  .hero-frame {
    mask-image: linear-gradient(to bottom, #000 35%, transparent 90%);
  }
</style>
