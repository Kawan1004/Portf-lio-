---
import { Image as AvatarImage } from 'astro:assets';
import avatar from '@/assets/avatar.jpg';
import ThemeToggle from './ThemeToggle.astro';
import { site } from '@/config/site';
import { languages, type Lang } from '@/i18n/ui';
import { localePath, stripLang, useTranslations } from '@/i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const home = localePath(lang);
const otherLang: Lang = lang === 'pt' ? 'en' : 'pt';
const otherPath = localePath(otherLang, stripLang(Astro.url.pathname));

const links = [
  { href: '#sobre', label: t('nav.about') },
  { href: '#projetos', label: t('nav.projects') },
  { href: '#stack', label: t('nav.stack') },
  { href: '#experiencia', label: t('nav.experience') },
  { href: '#contato', label: t('nav.contact') },
].map((l) => ({ ...l, href: `${home === '/' ? '' : home}/${l.href}` }));
---

<header data-autohide class="glass sticky top-0 z-40 border-b border-border transition-transform duration-500 ease-(--ease-out-soft)">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href={home} class="inline-flex h-11 items-center gap-2.5 text-base font-semibold tracking-tight">
      <AvatarImage src={avatar} alt="" width={64} height={64} class="size-9 rounded-full object-cover ring-2 ring-bg shadow-sm" loading="eager" />
      {site.name}
    </a>

    <nav aria-label={t('a11y.mainNav')} class="hidden md:block">
      <ul class="flex items-center gap-1 text-sm">
        {
          links.map((l) => (
            <li>
              <a href={l.href} data-nav-link class="nav-link rounded-md px-3 py-2 text-fg-muted transition-colors duration-200 hover:text-fg">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <a
        href={otherPath}
        hreflang={languages[otherLang].htmlLang}
        lang={languages[otherLang].htmlLang}
        class="inline-flex h-11 items-center rounded-full px-3 font-mono text-xs font-medium text-fg-muted transition-colors duration-200 hover:bg-surface-muted hover:text-fg"
      >
        {languages[otherLang].short}<span class="sr-only"> — {t('lang.switch')}</span>
      </a>
      <ThemeToggle label={t('theme.toggle')} />

      <details class="group relative md:hidden">
        <summary
          aria-label={t('a11y.menu')}
          class="inline-flex size-11 cursor-pointer list-none items-center justify-center rounded-full text-fg-muted hover:bg-surface-muted hover:text-fg [&::-webkit-details-marker]:hidden"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
            <path class="group-open:hidden" d="M4 7h16M4 12h16M4 17h16"></path>
            <path class="hidden group-open:block" d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </summary>
        <nav aria-label={t('a11y.mainNav')} class="absolute right-0 mt-2 w-56 rounded-xl border border-border bg-surface p-2 shadow-lg">
          <ul class="flex flex-col text-sm">
            {
              links.map((l) => (
                <li>
                  <a href={l.href} class="block rounded-md px-3 py-3 text-fg-muted hover:bg-surface-muted hover:text-fg">
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .nav-link[aria-current='true'] {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.5rem;
  }
</style>

<script>
  // Destaca no menu a seção visível no centro da tela.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]'));
  const byId = new Map(links.map((a) => [a.hash.slice(1), a]));
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        links.forEach((a) => a.removeAttribute('aria-current'));
        byId.get(e.target.id)?.setAttribute('aria-current', 'true');
      });
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  byId.forEach((_, id) => {
    const section = document.getElementById(id);
    if (section) observer.observe(section);
  });
</script>
