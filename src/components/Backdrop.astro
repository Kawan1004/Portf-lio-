---
// Fundo vivo: luz de estúdio + noise; o spotlight segue o cursor só quando o módulo de motion liga `.spotlight-on`.
---

<div aria-hidden="true" class="backdrop pointer-events-none fixed inset-0 -z-10 overflow-hidden">
  <div class="backdrop-glow absolute inset-0"></div>
  <div class="backdrop-spotlight absolute inset-0"></div>
  <div class="backdrop-noise absolute inset-0"></div>
</div>

<style>
  /* Luz de estúdio: centro claro e bordas levemente escurecidas, como um fundo fotográfico. */
  .backdrop-glow {
    background:
      radial-gradient(70rem 45rem at 50% 30%, var(--glow), transparent 70%),
      radial-gradient(120% 90% at 50% 40%, transparent 55%, color-mix(in oklab, var(--fg) 7%, transparent) 100%);
  }
  .backdrop-spotlight {
    opacity: 0;
    transition: opacity 0.6s var(--ease-out-soft);
    background: radial-gradient(36rem circle at var(--mx, 50%) var(--my, 30%), var(--glow), transparent 60%);
  }
  :global(.spotlight-on) .backdrop-spotlight {
    opacity: 0.7;
  }
  .backdrop-noise {
    background-image: url('/noise.svg');
    opacity: 0.035;
  }
  :global([data-theme='light']) .backdrop-noise {
    opacity: 0.05;
    filter: invert(1);
  }
</style>
