---
// Ilustração vetorial de um ângulo do veículo, no estilo de foto de vistoria (sem imagens reais).
interface Props {
  view: 'front' | 'rear' | 'left' | 'right' | 'dashboard' | 'engine';
}
const { view } = Astro.props;
const body = '#0e7490';
const glass = '#bfe3ec';
const dark = '#1f2933';
---

<svg viewBox="0 0 120 90" class="size-full" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
  <defs>
    <linearGradient id={`bg-${view}`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#eef6f8" />
      <stop offset="0.62" stop-color="#dcebef" />
      <stop offset="0.62" stop-color="#c9d6db" />
      <stop offset="1" stop-color="#b9c7cc" />
    </linearGradient>
  </defs>
  <rect width="120" height="90" fill={`url(#bg-${view})`} />

  {
    (view === 'left' || view === 'right') && (
      <g transform={view === 'right' ? 'translate(120 0) scale(-1 1)' : undefined}>
        <ellipse cx="60" cy="66" rx="48" ry="4" fill="#000" opacity="0.15" />
        <path d="M14 58 V50 Q14 45 20 44 L34 42 L46 31 Q49 28 54 28 H76 Q81 28 84 32 L93 42 L102 44 Q107 45 107 51 V58 Z" fill={body} />
        <path d="M48 42 L55 32 H66 V42 Z M69 32 H76 Q78 32 80 34 L86 42 H69 Z" fill={glass} />
        <rect x="16" y="49" width="6" height="3" rx="1.5" fill="#fde68a" />
        <rect x="100" y="49" width="6" height="3" rx="1.5" fill="#f87171" />
        <circle cx="32" cy="58" r="8" fill={dark} />
        <circle cx="32" cy="58" r="3.5" fill="#9ca3af" />
        <circle cx="88" cy="58" r="8" fill={dark} />
        <circle cx="88" cy="58" r="3.5" fill="#9ca3af" />
      </g>
    )
  }
  {
    (view === 'front' || view === 'rear') && (
      <g>
        <ellipse cx="60" cy="70" rx="40" ry="4" fill="#000" opacity="0.15" />
        <path d="M24 66 V48 Q24 42 30 41 L38 28 Q40 25 45 25 H75 Q80 25 82 28 L90 41 Q96 42 96 48 V66 Z" fill={body} />
        <path d="M40 40 L45 30 H75 L80 40 Z" fill={glass} />
        {view === 'front' ? (
          <>
            <rect x="28" y="46" width="14" height="6" rx="3" fill="#fde68a" />
            <rect x="78" y="46" width="14" height="6" rx="3" fill="#fde68a" />
            <rect x="46" y="48" width="28" height="7" rx="2" fill={dark} opacity="0.8" />
          </>
        ) : (
          <>
            <rect x="28" y="46" width="14" height="6" rx="3" fill="#f87171" />
            <rect x="78" y="46" width="14" height="6" rx="3" fill="#f87171" />
            <rect x="48" y="55" width="24" height="7" rx="1.5" fill="#f8fafc" />
            <rect x="52" y="57.5" width="16" height="2" rx="1" fill={dark} />
          </>
        )}
        <rect x="26" y="64" width="10" height="7" rx="2" fill={dark} />
        <rect x="84" y="64" width="10" height="7" rx="2" fill={dark} />
      </g>
    )
  }
  {
    view === 'dashboard' && (
      <g>
        <rect width="120" height="90" fill="#1f2933" />
        <path d="M0 52 Q60 30 120 52 V90 H0 Z" fill="#111827" />
        <circle cx="42" cy="56" r="13" fill="none" stroke="#67e8f9" stroke-width="2" />
        <path d="M42 56 L50 49" stroke="#fde68a" stroke-width="2" stroke-linecap="round" />
        <circle cx="78" cy="56" r="13" fill="none" stroke="#67e8f9" stroke-width="2" />
        <path d="M78 56 L72 47" stroke="#fde68a" stroke-width="2" stroke-linecap="round" />
        <circle cx="60" cy="78" r="16" fill="none" stroke="#4b5563" stroke-width="4" />
        <rect x="50" y="40" width="20" height="8" rx="2" fill="#0e7490" opacity="0.7" />
      </g>
    )
  }
  {
    view === 'engine' && (
      <g>
        <rect width="120" height="90" fill="#374151" />
        <rect x="18" y="20" width="84" height="54" rx="6" fill="#1f2933" />
        <rect x="30" y="30" width="38" height="22" rx="3" fill="#6b7280" />
        {[0, 1, 2, 3].map((k) => (
          <rect x={33 + k * 9} y="33" width="5" height="16" rx="1.5" fill="#9ca3af" />
        ))}
        <circle cx="84" cy="38" r="9" fill="#0e7490" />
        <circle cx="84" cy="38" r="4" fill="#bfe3ec" />
        <rect x="74" y="56" width="20" height="10" rx="2" fill="#fde68a" />
        <path d="M30 62 H66" stroke="#f87171" stroke-width="3" stroke-linecap="round" />
      </g>
    )
  }
</svg>
