---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import SectionHeader from './SectionHeader.astro';
import { site } from '@/config/site';
import type { Lang, UIKey } from '@/i18n/ui';
import { useTranslations } from '@/i18n/utils';
import anthropicLogo from '@/assets/logos/anthropic-white.svg';
import bradescoLogo from '@/assets/logos/fundacao-bradesco-white.svg';
import wizardLogo from '@/assets/logos/wizard-white.png';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Logos oficiais (versões para fundo escuro), por instituição emissora.
const issuerLogos: Record<string, { src: ImageMetadata; name: string; size: 'sm' | 'md' }> = {
  'Anthropic Academy': { src: anthropicLogo, name: 'Anthropic', size: 'sm' },
  'Fundação Bradesco': { src: bradescoLogo, name: 'Fundação Bradesco', size: 'md' },
  Wizard: { src: wizardLogo, name: 'Wizard by Pearson', size: 'md' },
};

// Diploma opcional: imagem já tratada (dados pessoais mascarados) em src/assets/diploma.(jpg|png|webp).
const diplomas = import.meta.glob<{ default: ImageMetadata }>('/src/assets/diploma.{jpg,jpeg,png,webp}', { eager: true });
const diploma = Object.values(diplomas)[0]?.default;
const diplomaLarge = diploma ? (await getImage({ src: diploma, width: 1800, format: 'webp', quality: 90 })).src : '';

// A ordem do YAML já segue a sequência de cores (claros → intermediários → azuis → verdes).
const certs = await Promise.all(
  (await getCollection('certifications'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async ({ id, data }) => ({
      id,
      ...data,
      color: data.color ?? '#9aa3b2',
      // Proporção diferente do padrão (1600×1211): mantém a original para não cortar assinatura/QR code.
      natural: data.image ? Math.abs(data.image.width / data.image.height - 1600 / 1211) > 0.04 : false,
      logo: issuerLogos[data.issuer],
      categoryLabel: t(`certs.cat.${data.category}` as UIKey),
      statusLabel: t(data.status === 'concluido' ? 'certs.done' : 'certs.inProgress'),
      large: data.image ? (await getImage({ src: data.image, width: 1600, format: 'webp', quality: 90 })).src : '',
    })),
);
---

<section id="certificacoes" aria-labelledby="certificacoes-title" data-theme="dark" class="cert-section relative isolate scroll-mt-16 overflow-hidden text-fg">
  <!-- Iluminação difusa: assume a cor do certificado em destaque no carrossel -->
  <div class="cert-light pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="container-page py-24 sm:py-32">
    <SectionHeader id="certificacoes" title={t('section.certifications')} lead={t('certs.lead')} />

    <!-- Formação acadêmica em destaque -->
    <article class="edu-card" aria-labelledby="edu-title" data-reveal>
      <div class="edu-visual">
        {
          diploma ? (
            <button
              type="button"
              class="edu-diploma"
              aria-label={`${t('education.view')}: ${site.education.course[lang]}`}
              data-cert-title={site.education.course[lang]}
              data-cert-meta={`${site.education.institution} · ${t('education.completed')} ${site.education.year}`}
              data-cert-image={diplomaLarge}
            >
              <Image src={diploma} alt="" widths={[600, 1000, 1400]} sizes="(min-width: 1024px) 560px, 90vw" quality={90} class="size-full object-contain" />
            </button>
          ) : (
            <div class="edu-placeholder" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 10 12 5 2 10l10 5 10-5Z" />
                <path d="M6 12v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5" />
                <path d="M22 10v6" />
              </svg>
              <span>{t('education.soon')}</span>
            </div>
          )
        }
      </div>
      <div class="edu-body">
        <p class="text-sm text-fg-muted">{t('education.label')} · {t('education.degree')}</p>
        <h3 id="edu-title" class="mt-3 text-3xl leading-tight font-semibold sm:text-4xl">{site.education.course[lang]}</h3>
        <p class="mt-4 text-lg text-fg-muted">{site.education.institution}</p>
        <p class="edu-year">
          <span>{t('education.completed')}</span>
          <strong>{site.education.year}</strong>
        </p>
      </div>
    </article>

    <h3 class="mt-24 mb-2 text-2xl font-semibold sm:text-3xl" data-reveal>{t('certs.heading')}</h3>

    <div class="cert-carousel" role="region" aria-roledescription="carrossel" aria-label={t('certs.carousel')} data-reveal>
      <button type="button" class="cert-nav is-prev" aria-label={t('certs.prev')} aria-controls="cert-track" data-cert-prev>
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
      </button>

      <ul id="cert-track" class="cert-track" role="list" tabindex="0" data-lenis-prevent data-cert-track>
        {
          certs.map((c) => {
            const label = `${c.title} — ${c.issuer}, ${c.statusLabel}`;
            const media = c.image ? (
              <span class:list={['cert-media', c.natural && 'is-natural']}>
                <Image
                  src={c.image}
                  alt=""
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 1024px) 380px, (min-width: 640px) 45vw, 82vw"
                  quality={90}
                  class="cert-img"
                  draggable="false"
                />
              </span>
            ) : (
              <span class="cert-media cert-text">
                <span class="text-lg leading-snug font-medium text-balance text-fg">{c.title}</span>
                <span class="text-xs text-fg-muted">{c.categoryLabel}</span>
              </span>
            );
            const caption = (
              <span class="cert-caption">
                {c.logo ? (
                  <img src={c.logo.src.src} alt="" width={c.logo.src.width} height={c.logo.src.height} class:list={['cert-logo', `is-${c.logo.size}`]} />
                ) : (
                  <span class="truncate">{c.issuer}</span>
                )}
                <span class="cert-status">{c.statusLabel}</span>
              </span>
            );
            return (
              <li class="cert-item" data-cert-color={c.color}>
                {c.credentialUrl ? (
                  <a href={c.credentialUrl} target="_blank" rel="noopener" class="cert-card" aria-label={`${t('certs.verify')}: ${label} (${t('certs.newTab')})`}>
                    {media}
                    {caption}
                    <span class="cert-badge" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M7 17 17 7M9 7h8v8" />
                      </svg>
                    </span>
                  </a>
                ) : (
                  <button
                    type="button"
                    class="cert-card"
                    aria-label={`${t('certs.open')}: ${label}`}
                    data-cert-title={c.title}
                    data-cert-meta={[c.issuer, c.categoryLabel, c.statusLabel].join(' · ')}
                    data-cert-image={c.large}
                  >
                    {media}
                    {caption}
                  </button>
                )}
              </li>
            );
          })
        }
      </ul>

      <button type="button" class="cert-nav is-next" aria-label={t('certs.next')} aria-controls="cert-track" data-cert-next>
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
      </button>
    </div>

    <div class="cert-controls" data-reveal>
      <p class="cert-count" aria-hidden="true"><span data-cert-current>01</span> / {String(certs.length).padStart(2, '0')}</p>
      <span class="cert-progress" aria-hidden="true"><span data-cert-bar></span></span>
      <p class="sr-only" aria-live="polite" data-cert-live data-template={t('certs.position')}></p>
    </div>

  </div>

  <dialog class="cert-dialog" data-cert-dialog aria-labelledby="cert-dialog-title">
    <div class="flex max-h-[90svh] flex-col gap-5 overflow-auto">
      <div class="flex items-start justify-between gap-6">
        <div>
          <p class="text-xs text-fg-muted" data-cert-dialog-meta></p>
          <h3 id="cert-dialog-title" class="mt-1 text-2xl font-semibold" data-cert-dialog-title></h3>
        </div>
        <button type="button" class="inline-flex size-11 shrink-0 cursor-pointer items-center justify-center rounded-full border border-border hover:border-fg" data-cert-close aria-label={t('certs.close')}>
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
        </button>
      </div>
      <img data-cert-dialog-image alt="" class="hidden w-full rounded-xl" />
      <p data-cert-dialog-empty class="hidden rounded-xl border border-dashed border-border p-8 text-center text-sm text-fg-muted">{t('certs.noImage')}</p>
    </div>
  </dialog>
</section>

<style>
  /* Cor do certificado em destaque; transita suavemente via @property. */
  @property --cert-glow {
    syntax: '<color>';
    inherits: true;
    initial-value: #e3dacb;
  }

  /* Fundo nunca preto puro: base escura tingida pela cor atual (texto mantém contraste AA). */
  .cert-section {
    background-color: color-mix(in oklab, var(--cert-glow) 26%, #0a0b0e);
    transition: --cert-glow 1.1s var(--ease-out-soft);
  }
  @media (prefers-reduced-motion: reduce) {
    .cert-section {
      transition: none;
    }
  }

  .cert-light {
    background:
      radial-gradient(60% 45% at 20% 35%, color-mix(in oklab, var(--cert-glow) 30%, transparent), transparent 70%),
      radial-gradient(55% 45% at 85% 65%, color-mix(in oklab, var(--cert-glow) 24%, transparent), transparent 70%),
      radial-gradient(120% 40% at 50% 100%, color-mix(in oklab, var(--cert-glow) 16%, transparent), transparent 75%);
  }

  /* Carrossel infinito: rola devagar sozinho; as setas avançam um certificado por vez. */
  .cert-carousel {
    position: relative;
  }
  .cert-track {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    margin-inline: -0.5rem;
    padding: 1.5rem 0.5rem 2rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0.5rem;
    scrollbar-width: none;
  }
  .cert-track::-webkit-scrollbar {
    display: none;
  }
  /* Durante a rolagem automática o snap atrapalharia o movimento contínuo. */
  .cert-track.is-auto {
    scroll-snap-type: none;
  }
  .cert-track:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 4px;
    border-radius: 1.5rem;
  }
  .cert-item {
    flex: 0 0 82%;
    scroll-snap-align: start;
  }
  @media (min-width: 640px) {
    .cert-item {
      flex-basis: calc((100% - 1.25rem) / 2);
    }
  }
  @media (min-width: 1024px) {
    .cert-track {
      gap: 2rem;
    }
    .cert-item {
      flex-basis: calc((100% - 4rem) / 3);
    }
  }

  .cert-nav {
    position: absolute;
    top: 42%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    translate: 0 -50%;
    cursor: pointer;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.18);
    background: rgb(18 18 22 / 0.6);
    color: #fff;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.7);
    transition:
      background-color 0.3s,
      border-color 0.3s,
      opacity 0.3s,
      scale 0.2s;
  }
  .cert-nav:hover:not(:disabled) {
    background: rgb(255 255 255 / 0.16);
    border-color: rgb(255 255 255 / 0.35);
  }
  .cert-nav:active:not(:disabled) {
    scale: 0.94;
  }
  .cert-nav:disabled {
    opacity: 0.25;
    cursor: default;
  }
  .cert-nav:focus-visible {
    outline: 3px solid var(--ring);
    outline-offset: 3px;
  }
  .cert-nav.is-prev {
    left: 0.25rem;
  }
  .cert-nav.is-next {
    right: 0.25rem;
  }
  @media (min-width: 1280px) {
    .cert-nav.is-prev {
      left: -1.75rem;
    }
    .cert-nav.is-next {
      right: -1.75rem;
    }
  }

  /* Telas pequenas: setas descem para a linha do contador, sem cobrir os certificados. */
  @media (max-width: 639px) {
    .cert-nav {
      top: auto;
      bottom: -3.4rem;
      translate: none;
      width: 2.75rem;
      height: 2.75rem;
    }
    .cert-nav.is-prev {
      left: auto;
      right: 3.5rem;
    }
    .cert-nav.is-next {
      right: 0;
    }
    .cert-controls {
      padding-right: 7rem;
      min-height: 2.75rem;
    }
  }

  .cert-controls {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 0.5rem;
  }
  .cert-count {
    font-size: 0.85rem;
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }
  .cert-count span {
    color: var(--fg);
    font-weight: 600;
  }
  .cert-progress {
    position: relative;
    flex: 1;
    height: 2px;
    overflow: hidden;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.14);
  }
  .cert-progress span {
    position: absolute;
    inset: 0;
    transform-origin: left;
    transform: scaleX(0.1);
    background: var(--cert-glow);
    transition: transform 0.4s var(--ease-out-soft);
  }

  /* Formação acadêmica: card largo de vidro com o diploma em evidência. */
  .edu-card {
    display: grid;
    gap: 2rem;
    align-items: center;
    padding: 1rem;
    border-radius: 1.75rem;
    border: 1px solid rgb(255 255 255 / 0.14);
    background: linear-gradient(150deg, rgb(255 255 255 / 0.12), rgb(255 255 255 / 0.03));
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    box-shadow:
      inset 0 1px 0 0 rgb(255 255 255 / 0.14),
      0 40px 80px -40px rgb(0 0 0 / 0.8),
      0 0 120px -40px color-mix(in oklab, var(--cert-glow) 60%, transparent);
  }
  @media (min-width: 1024px) {
    .edu-card {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 3.5rem;
      padding: 1.25rem 3.5rem 1.25rem 1.25rem;
    }
  }
  .edu-visual {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 1.1rem;
    background: rgb(255 255 255 / 0.04);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }
  /* Com o diploma, o quadro assume a proporção real do documento (sem cortes nem faixas). */
  .edu-visual:has(.edu-diploma) {
    aspect-ratio: auto;
    background: none;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.8);
  }
  .edu-diploma :global(img) {
    height: auto;
  }
  .edu-diploma {
    display: block;
    width: 100%;
    height: 100%;
    cursor: zoom-in;
    transition: scale 0.6s var(--ease-out-soft);
  }
  .edu-diploma:hover {
    scale: 1.02;
  }
  .edu-diploma:focus-visible {
    outline: 3px solid var(--ring);
    outline-offset: -3px;
  }
  .edu-placeholder {
    display: flex;
    height: 100%;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    color: var(--fg-muted);
    font-size: 0.9rem;
    background:
      radial-gradient(60% 60% at 50% 40%, rgb(255 255 255 / 0.08), transparent 70%),
      repeating-linear-gradient(135deg, rgb(255 255 255 / 0.025) 0 1px, transparent 1px 14px);
  }
  .edu-placeholder svg {
    width: 4rem;
    height: 4rem;
    opacity: 0.7;
  }
  .edu-body {
    padding: 0.5rem 0.75rem 1rem;
  }
  .edu-year {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(255 255 255 / 0.12);
    color: var(--fg-muted);
    font-size: 0.9rem;
  }
  .edu-year strong {
    color: var(--fg);
    font-size: 2.5rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .cert-item {
    --c: #9aa3b2;
    position: relative;
  }
  /* Halo difuso na cor do próprio certificado, atrás do card. */
  .cert-item::before {
    content: '';
    position: absolute;
    inset: 8% 6%;
    z-index: -1;
    border-radius: 2rem;
    background: radial-gradient(closest-side, color-mix(in oklab, var(--c) 45%, transparent), transparent);
    opacity: 0.55;
    transition: opacity 0.5s var(--ease-out-soft);
  }
  .cert-item:hover::before,
  .cert-item:focus-within::before {
    opacity: 0.95;
  }

  /* Card de vidro: o desfoque atua no que está atrás, nunca no certificado. */
  .cert-card {
    position: relative;
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 0.85rem;
    padding: 0.7rem 0.7rem 0.85rem;
    cursor: pointer;
    border-radius: 1.25rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    background: linear-gradient(160deg, rgb(255 255 255 / 0.1), rgb(255 255 255 / 0.03));
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    box-shadow:
      inset 0 1px 0 0 rgb(255 255 255 / 0.12),
      0 24px 50px -28px rgb(0 0 0 / 0.75);
    text-align: left;
    transition:
      translate 0.5s var(--ease-out-soft),
      border-color 0.4s,
      box-shadow 0.5s var(--ease-out-soft);
  }
  .cert-card:hover {
    translate: 0 -6px;
    border-color: color-mix(in oklab, var(--c) 55%, rgb(255 255 255 / 0.3));
    box-shadow:
      inset 0 1px 0 0 rgb(255 255 255 / 0.18),
      0 34px 60px -28px rgb(0 0 0 / 0.85),
      0 0 60px -18px color-mix(in oklab, var(--c) 70%, transparent);
  }
  .cert-card:focus-visible {
    outline: 3px solid var(--ring);
    outline-offset: 3px;
  }

  .cert-media {
    display: block;
    aspect-ratio: 1600 / 1211;
    overflow: hidden;
    border-radius: 0.8rem;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.2);
  }
  .cert-media.is-natural {
    aspect-ratio: auto;
  }
  .cert-media.is-natural :global(.cert-img) {
    height: auto;
  }
  .cert-media :global(.cert-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
  }
  .cert-text {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem;
    background: linear-gradient(160deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.01));
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }

  /* Legenda: logo oficial da instituição + status, fora da imagem do certificado. */
  .cert-caption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 1.25rem;
    padding-inline: 0.35rem;
    font-size: 0.78rem;
    color: var(--fg-muted);
  }
  .cert-logo {
    width: auto;
    height: 0.62rem;
  }
  .cert-logo.is-md {
    height: 1.2rem;
  }
  .cert-status {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .cert-status::before {
    content: '';
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--c);
    box-shadow: 0 0 10px var(--c);
  }

  .cert-badge {
    position: absolute;
    top: 1.3rem;
    right: 1.3rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    background: rgb(10 10 12 / 0.75);
    color: #fff;
    opacity: 0;
    translate: 0 4px;
    transition:
      opacity 0.3s,
      translate 0.3s var(--ease-out-soft);
  }
  .cert-badge svg {
    width: 0.9rem;
    height: 0.9rem;
  }
  .cert-card:hover .cert-badge,
  .cert-card:focus-visible .cert-badge {
    opacity: 1;
    translate: 0 0;
  }

  .cert-dialog {
    margin: auto;
    width: min(60rem, calc(100vw - 2rem));
    border-radius: 1.5rem;
    border: 1px solid var(--border-strong);
    background: #0d0e12;
    color: var(--fg);
    padding: 1.5rem;
  }
  .cert-dialog::backdrop {
    background: rgb(0 0 0 / 0.7);
    backdrop-filter: blur(6px);
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('#certificacoes');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-cert-color]'));

  // Cor de cada certificado via CSSOM (CSP-safe): card, halo e legenda herdam --c.
  items.forEach((item) => item.style.setProperty('--c', item.dataset['certColor'] ?? ''));

  // Carrossel: setas, teclado e contador; o fundo assume a cor do certificado em destaque.
  const track = document.querySelector<HTMLElement>('[data-cert-track]');
  const prev = document.querySelector<HTMLButtonElement>('[data-cert-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-cert-next]');
  const current = document.querySelector<HTMLElement>('[data-cert-current]');
  const bar = document.querySelector<HTMLElement>('[data-cert-bar]');
  const live = document.querySelector<HTMLElement>('[data-cert-live]');

  if (section && track && prev && next && items.length > 1) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const n = items.length;

    // Loop infinito: uma cópia decorativa da lista (inerte para teclado e leitores de tela) vem logo depois.
    items.forEach((item) => {
      const clone = item.cloneNode(true) as HTMLElement;
      clone.setAttribute('aria-hidden', 'true');
      clone.inert = true;
      track.append(clone);
    });
    const all = Array.from(track.querySelectorAll<HTMLElement>('[data-cert-color]'));

    const step = () => items[1]!.offsetLeft - items[0]!.offsetLeft;
    const loopWidth = () => all[n]!.offsetLeft - items[0]!.offsetLeft;
    const wrap = () => {
      const w = loopWidth();
      if (track.scrollLeft >= w) track.scrollLeft -= w;
      else if (track.scrollLeft <= 0) track.scrollLeft += w;
    };

    // Rolagem automática lenta; pausa com hover, foco, toque, aba oculta ou seção fora da tela.
    const SPEED = 28; // px/s
    let pos = 0;
    let last = 0;
    let visible = false;
    let hold = 0; // timestamp até quando o autoplay fica pausado após interação
    const paused = () => reduced || !visible || document.hidden || performance.now() < hold || track.matches(':hover, :focus-within');
    const pauseFor = (ms: number) => {
      hold = performance.now() + ms;
    };
    const tick = (now: number) => {
      const dt = last ? Math.min(now - last, 64) : 0;
      last = now;
      if (paused()) {
        pos = track.scrollLeft;
      } else {
        pos += (SPEED * dt) / 1000;
        const w = loopWidth();
        if (pos >= w) pos -= w;
        track.scrollLeft = pos;
      }
      requestAnimationFrame(tick);
    };
    if (!reduced) {
      track.classList.add('is-auto');
      new IntersectionObserver(([e]) => {
        visible = Boolean(e?.isIntersecting);
      }).observe(track);
      requestAnimationFrame(tick);
    }

    const go = (dir: 1 | -1) => {
      pauseFor(2500);
      wrap();
      track.scrollBy({ left: dir * step(), behavior: reduced ? 'auto' : 'smooth' });
    };
    ['pointerdown', 'wheel', 'touchstart'].forEach((ev) => track.addEventListener(ev, () => pauseFor(2500), { passive: true }));

    let frame = 0;
    let settle = 0;
    const pad = (v: number) => String(v).padStart(2, '0');
    const update = () => {
      const s = step();
      const idx = Math.round(track.scrollLeft / s);
      const perView = Math.max(1, Math.round(track.clientWidth / s));
      const first = (idx % n) + 1;
      const lastShown = ((idx + perView - 1) % n) + 1;
      if (current) current.textContent = perView > 1 ? `${pad(first)}–${pad(lastShown)}` : pad(first);
      if (bar) bar.style.transform = `scaleX(${first / n})`;
      // A cor de fundo acompanha o certificado mais ao centro.
      const focus = all[Math.min(idx + Math.floor(perView / 2), all.length - 1)];
      section.style.setProperty('--cert-glow', focus?.dataset['certColor'] ?? '');
    };
    const announce = () => {
      const idx = Math.round(track.scrollLeft / step()) % n;
      if (live) live.textContent = (live.dataset['template'] ?? '').replace('{n}', String(idx + 1)).replace('{total}', String(n));
    };

    track.addEventListener(
      'scroll',
      () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(update);
        clearTimeout(settle);
        settle = window.setTimeout(() => {
          if (paused()) wrap();
          announce();
        }, 180);
      },
      { passive: true },
    );
    window.addEventListener('resize', update);
    prev.disabled = false;
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener('keydown', (e) => {
      if (e.target !== track || (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft')) return;
      e.preventDefault();
      go(e.key === 'ArrowRight' ? 1 : -1);
    });
    update();
  }

  // Modal só para certificados sem link de credencial; os demais abrem a página oficial.
  const dialog = document.querySelector<HTMLDialogElement>('[data-cert-dialog]');
  if (dialog) {
    const q = <T extends HTMLElement>(sel: string) => dialog.querySelector<T>(sel)!;
    const title = q('[data-cert-dialog-title]');
    const meta = q('[data-cert-dialog-meta]');
    const img = q<HTMLImageElement>('[data-cert-dialog-image]');
    const empty = q('[data-cert-dialog-empty]');

    document.querySelectorAll<HTMLButtonElement>('button[data-cert-title]').forEach((card) => {
      card.addEventListener('click', () => {
        const d = card.dataset;
        title.textContent = d['certTitle'] ?? '';
        meta.textContent = d['certMeta'] ?? '';
        img.classList.toggle('hidden', !d['certImage']);
        empty.classList.toggle('hidden', Boolean(d['certImage']));
        if (d['certImage']) {
          img.src = d['certImage'];
          img.alt = d['certTitle'] ?? '';
        }
        dialog.showModal();
      });
    });
    q('[data-cert-close]').addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
  }
</script>
