---
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: { title: string; description: string; updated: string };
}
const { title, description, updated } = Astro.props.frontmatter;
---

<BaseLayout title={title} description={description}>
  <article class="container-page py-16 sm:py-24">
    <h1 class="text-4xl font-semibold sm:text-5xl">{title}</h1>
    <p class="mt-3 text-sm text-fg-muted">{updated}</p>
    <div class="case-prose case-prose--plain mt-10 max-w-2xl">
      <slot />
    </div>
  </article>
</BaseLayout>
