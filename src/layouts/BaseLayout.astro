---
import '@/styles/global.css';
import themeInit from '@/scripts/theme-init.js?raw';
import Header from '@/components/Header.astro';
import Backdrop from '@/components/Backdrop.astro';
import { site } from '@/config/site';
import { languages, type Lang } from '@/i18n/ui';
import { getLang, localePath, stripLang, useTranslations } from '@/i18n/utils';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
}

const lang: Lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const title = Astro.props.title ? `${Astro.props.title} · ${site.name}` : `${site.name} · ${t('meta.title')}`;
const description = Astro.props.description ?? t('meta.description');
const basePath = stripLang(Astro.url.pathname);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site).href;
const isHome = basePath === '/';
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: t('meta.title'),
  url: new URL(localePath(lang), Astro.site).href,
  address: { '@type': 'PostalAddress', addressLocality: 'São Paulo', addressCountry: 'BR' },
  sameAs: [site.social.linkedin, site.social.github],
  knowsLanguage: ['pt-BR', 'en'],
};
const alternates = (Object.keys(languages) as Lang[]).map((l) => ({
  hreflang: languages[l].htmlLang,
  href: new URL(localePath(l, basePath), Astro.site).href,
}));
---

<!doctype html>
<html lang={languages[lang].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0]?.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={Astro.props.type ?? 'website'} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} · ${t('meta.title')}`} />
    <meta property="og:locale" content={languages[lang].ogLocale} />
    {
      (Object.keys(languages) as Lang[])
        .filter((l) => l !== lang)
        .map((l) => <meta property="og:locale:alternate" content={languages[l].ogLocale} />)
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(personLd)} />}
    <meta name="theme-color" content="#f3f3f2" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline set:html={themeInit} />
  </head>
  <body>
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-accent-fg"
    >
      {t('a11y.skip')}
    </a>
    <Backdrop />
    <div class="fixed inset-x-0 top-0 z-50 h-0.5 origin-left scale-x-0 bg-linear-to-r from-accent to-accent-2" data-scroll-progress aria-hidden="true"></div>
    <Header lang={lang} />
    <main id="conteudo" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <script>
      import { initMotion } from '@/lib/motion';
      initMotion();
    </script>
  </body>
</html>
